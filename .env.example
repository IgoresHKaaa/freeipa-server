#FreeIPA environment
#Copy to .env and adjust values

#FreeIPA Directory Server password
IPA_DS_PASSWORD=a1b2c3

#FreeIPA administrator password
IPA_ADMIN_PASSWORD=a1b2c3

#Kerberos realm 
IPA_REALM=example.com

#DNS domain
IPA_DOMAIN=example.com

#FreeIPA server hostname (FQDN)
IPA_HOSTNAME=freeipa.example.com

#FreeIPA server IP address
IPA_IP=docker_network

#NetBIOS name
IPA_NETBIOS_NAME=FREEIPA
